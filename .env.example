# Local mode — no cloud account required
# All data is stored in data/attendance.json on this computer

# Shared secret entered on the kiosk device (must match)
KIOSK_SECRET=dev-kiosk-secret-change-me

# Cookie signing secret for admin login
SESSION_SECRET=local-dev-session-secret-change-me

# Face match: Euclidean distance threshold (lower = stricter). Typical: 0.45–0.6
FACE_MATCH_THRESHOLD=0.55

# Ignore duplicate clock events within this many seconds
CLOCK_DEDUPE_SECONDS=45

# Default site timezone (IANA). Philippines = Asia/Manila
# Sites store their own timezone; this is the fallback/seed default.
# DEFAULT_TIMEZONE=Asia/Manila
